# --- Controller ---
MH_HTTP_ADDR=:8080
MH_PUBLIC_URL=http://localhost:8080
MH_DATABASE_URL=postgres://managerhub:managerhub@localhost:5432/managerhub?sslmode=disable
MH_JWT_SECRET=change-me-to-a-long-random-string
MH_ENROLL_TOKEN_TTL=24h
MH_METRICS_RETENTION=168h
MH_JOBLOG_RETENTION=720h
MH_LOG_LEVEL=info

# --- Agent ---
MH_CONTROLLER_URL=http://localhost:8080
MH_ENROLL_TOKEN=
MH_AGENT_NAME=
MH_AGENT_STATE=/var/lib/managerhub/agent.state.json
MH_HEARTBEAT_INTERVAL=10s
MH_METRICS_INTERVAL=15s
