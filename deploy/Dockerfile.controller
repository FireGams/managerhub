FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/controller ./controller/cmd/controller

FROM alpine:3.20
RUN adduser -D -u 10001 mh
USER mh
WORKDIR /app
COPY --from=build /out/controller /app/controller
EXPOSE 8080
ENTRYPOINT ["/app/controller"]
